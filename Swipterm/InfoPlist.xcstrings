      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لبرامج Linux في Swipterm الاتصال بالأجهزة على شبكتك المحلية وقبول الاتصالات منها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програмите за Linux в Swipterm могат да се свързват с устройства в локалната Ви мрежа и да приемат връзки от тях."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipterm-এর Linux প্রোগ্রামগুলি আপনার লোকাল নেটওয়ার্কের ডিভাইসগুলিতে কানেক্ট করতে পারে এবং সেগুলি থেকে আসা কানেকশন গ্রহণ করতে পারে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els programes Linux del Swipterm poden connectar-se als dispositius de la xarxa local i acceptar-ne connexions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linuxové programy ve Swipterm se mohou připojovat k zařízením ve vaší místní síti a přijímat od nich připojení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linux-programmer i Swipterm kan oprette forbindelse til enheder på dit lokale netværk og acceptere forbindelser fra dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linux-Programme in Swipterm können sich mit Geräten in deinem lokalen Netzwerk verbinden und Verbindungen von ihnen annehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα προγράμματα Linux στο Swipterm μπορούν να συνδέονται σε συσκευές του τοπικού σας δικτύου και να αποδέχονται συνδέσεις από αυτές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Linux programs in Swipterm can connect to devices on your local network and accept connections from them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los programas de Linux de Swipterm pueden conectarse a dispositivos de tu red local y aceptar conexiones de ellos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los programas de Linux de Swipterm pueden conectarse a dispositivos de tu red local y aceptar conexiones de ellos."
