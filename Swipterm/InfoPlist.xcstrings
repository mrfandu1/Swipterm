        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipterm के Linux प्रोग्राम आपके लोकल नेटवर्क के डिवाइस से कनेक्ट हो सकते हैं और उनसे आने वाले कनेक्शन स्वीकार कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linux programi u aplikaciji Swipterm mogu se povezati s uređajima na vašoj lokalnoj mreži i prihvaćati veze s njih."
