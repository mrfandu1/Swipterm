        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipterm ನಲ್ಲಿರುವ Linux ಪ್ರೋಗ್ರಾಂಗಳು ನಿಮ್ಮ ಸ್ಥಳೀಯ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿರುವ ಸಾಧನಗಳಿಗೆ ಕನೆಕ್ಟ್ ಆಗಬಹುದು ಮತ್ತು ಅವುಗಳಿಂದ ಕನೆಕ್ಷನ್‌ಗಳನ್ನು ಸ್ವೀಕರಿಸಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipterm의 Linux 프로그램은 로컬 네트워크에 있는 기기에 연결하거나 해당 기기로부터의 연결을 수락할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Swipterm“ esančios „Linux“ programos gali prisijungti prie jūsų vietinio tinklo įrenginių ir priimti iš jų prisijungimus."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipterm-ലെ Linux പ്രോഗ്രാമുകൾക്ക് നിങ്ങളുടെ ലോക്കൽ നെറ്റ്‌വർക്കിലെ ഉപകരണങ്ങളിലേക്ക് കണക്റ്റ് ചെയ്യാനും അവയിൽ നിന്നുള്ള കണക്ഷനുകൾ സ്വീകരിക്കാനും കഴിയും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipterm मधील Linux प्रोग्राम तुमच्या लोकल नेटवर्कवरील डिव्हाइसशी कनेक्ट होऊ शकतात आणि त्यांच्याकडून येणारी कनेक्शन स्वीकारू शकतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Program Linux dalam Swipterm boleh menyambung ke peranti pada rangkaian setempat anda dan menerima sambungan daripada peranti tersebut."
