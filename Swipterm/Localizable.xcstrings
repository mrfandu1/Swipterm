{
  "sourceLanguage": "en",
  "strings": {
    "%@ has no kernel package for this release.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتوفر لدى %@ حزمة نواة لهذا الإصدار."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ няма пакет с ядро за тази версия."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ এই রিলিজের জন্য কোনো কার্নেল প্যাকেজ নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no té cap paquet de nucli per a aquesta versió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nemá pro toto vydání žádný balíček jádra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen kernepakke til denne version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat kein Kernel-Paket für diese Version."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ δεν διαθέτει πακέτο πυρήνα για αυτήν την έκδοση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene ningún paquete de kernel para esta versión."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene ningún paquete de kernel para esta versión."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ هیچ بستهٔ هسته‌ای برای این نسخه ندارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelimella %@ ei ole ydinpakettia tälle versiolle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne propose aucun paquet de noyau pour cette version."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne propose aucun paquet de noyau pour cette version."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@માં આ રિલીઝ માટે કોઈ કર્નલ પૅકેજ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל-%@ אין חבילת ליבה לגרסה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में इस रिलीज़ के लिए कोई कर्नेल पैकेज नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nema paket jezgre za ovo izdanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nem tartalmaz kernelcsomagot ehhez a kiadáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak memiliki paket kernel untuk rilis ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non dispone di un pacchetto kernel per questa versione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@には、このリリース用のカーネルパッケージがありません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ішінде осы шығарылымға арналған ядро бумасы жоқ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಬಿಡುಗಡೆಗೆ %@ ನಲ್ಲಿ ಯಾವುದೇ ಕರ್ನಲ್ ಪ್ಯಾಕೇಜ್ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이 릴리스용 커널 패키지가 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ neturi šiam leidimui skirto branduolio paketo."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ റിലീസിനുള്ള കേർണൽ പാക്കേജ് %@ എന്നതിൽ ഇല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ मध्ये या रिलीझसाठी कोणतेही कर्नेल पॅकेज नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiada pakej kernel untuk keluaran ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen kjernepakke for denne versjonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft geen kernelpakket voor deze versie."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ରିଲିଜ୍ ପାଇଁ %@ରେ କୌଣସି କର୍ଣ୍ଣେଲ୍ ପ୍ୟାକେଜ୍ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਵਿੱਚ ਇਸ ਰਿਲੀਜ਼ ਲਈ ਕੋਈ ਕਰਨਲ ਪੈਕੇਜ ਨਹੀਂ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie ma pakietu jądra dla tego wydania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem um pacote de kernel para esta versão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem nenhum pacote de kernel para esta versão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu are niciun pachet de kernel pentru această versiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На зеркале «%@» нет пакета ядра для этого выпуска."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nemá pre toto vydanie žiadny balík jadra."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nima paketa jedra za to izdajo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har inget kärnpaket för den här versionen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வெளியீட்டுக்கான கெர்னல் தொகுப்பு %@ இல் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ రిలీజ్ కోసం %@‌లో కెర్నెల్ ప్యాకేజీ ఏదీ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่มีแพ็กเกจเคอร์เนลสำหรับรุ่นนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu sürüm için çekirdek paketi içermiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не має пакета ядра для цього випуску."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ میں اس ریلیز کے لیے کوئی کرنل پیکیج نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không có gói nhân cho bản phát hành này."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
