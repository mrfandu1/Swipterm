        }
      }
    },
    "The password can’t contain line breaks or control characters.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز عبور نمی‌تواند شامل خط جدید یا نویسه‌های کنترلی باشد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль не может содержать переносы строк или управляющие символы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码不能包含换行符或控制字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼不能包含換行字元或控制字元。"
          }
        }
      }
    },
    "The symbol bar is hidden while a hardware keyboard is connected unless this is enabled.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام اتصال صفحه‌کلید سخت‌افزاری، نوار نمادها پنهان می‌شود مگر اینکه این گزینه فعال باشد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока подключена аппаратная клавиатура, панель символов скрыта, если этот параметр не включён."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接硬件键盘时隐藏符号栏，除非开启此选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接硬體鍵盤時隱藏符號列，除非開啟此選項。"
          }
        }
      }
    },
