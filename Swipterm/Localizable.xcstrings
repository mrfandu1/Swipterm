    },
    "Use a port from %lld to %lld.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از پورتی بین %lld تا %lld استفاده کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте порт от %lld до %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 %lld 到 %lld 之间的端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 %lld 到 %lld 之間的連接埠。"
          }
        }
      }
    },
    "Use up to 32 lowercase letters, digits, “_” and “-”, starting with a letter or “_”.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از حداکثر ۳۲ حرف کوچک انگلیسی، رقم، «_» و «-» استفاده کنید و با یک حرف یا «_» شروع کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте до 32 строчных латинских букв, цифр, символов «_» и «-»; первым символом должна быть буква или «_»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多使用 32 个小写字母、数字、“_”和“-”，并以字母或“_”开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多使用 32 個小寫字母、數字、「_」和「-」，並以字母或「_」開頭。"
          }
        }
      }
    },
    "User": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کاربر"
          }
        },
        "ru": {
          "stringUnit": {
