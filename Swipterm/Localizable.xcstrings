    "The password can’t contain line breaks or control characters.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن تحتوي كلمة السر على فواصل أسطر أو أحرف تحكم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Паролата не може да съдържа нови редове или контролни символи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসওয়ার্ডে লাইন ব্রেক বা কন্ট্রোল ক্যারেক্টার থাকতে পারবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La contrasenya no pot contenir salts de línia ni caràcters de control."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Heslo nesmí obsahovat zalomení řádků ani řídicí znaky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangskoden må ikke indeholde linjeskift eller kontroltegn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort darf keine Zeilenumbrüche oder Steuerzeichen enthalten."
          }
        },
