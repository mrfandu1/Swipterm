    "Use up to 32 lowercase letters, digits, underscores (_), and hyphens (-), starting with a letter or underscore.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك استخدام ما يصل إلى ٣٢ حرفًا صغيرًا ورقمًا وشرطة سفلية (_) وواصلة (-)، على أن يبدأ الاسم بحرف أو شرطة سفلية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използвайте до 32 малки латински букви, цифри, долни черти (_) и тирета (-), като първият знак трябва да е буква или долна черта."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বোচ্চ 32টি ছোট হাতের অক্ষর, সংখ্যা, আন্ডারস্কোর (_) ও হাইফেন (-) ব্যবহার করুন, যার শুরু হবে একটি অক্ষর বা আন্ডারস্কোর দিয়ে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitza fins a 32 lletres minúscules, dígits, guions baixos (_) i guionets (-), començant amb una lletra o un guió baix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte nejvýše 32 malých písmen, číslic, podtržítek (_) a spojovníků (-). Jméno musí začínat písmenem nebo podtržítkem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug op til 32 små bogstaver, tal, understregningstegn (_) og bindestreger (-), og start med et bogstav eller et understregningstegn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende bis zu 32 Kleinbuchstaben, Ziffern, Unterstriche (_) und Bindestriche (-), beginnend mit einem Buchstaben oder Unterstrich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε έως 32 πεζά γράμματα, ψηφία, κάτω παύλες (_) και ενωτικά (-), με πρώτο χαρακτήρα ένα γράμμα ή μια κάτω παύλα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa hasta 32 letras minúsculas, dígitos, guiones bajos (_) y guiones (-), empezando por una letra o un guion bajo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa hasta 32 letras minúsculas, dígitos, guiones bajos (_) y guiones (-), empezando por una letra o un guion bajo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حداکثر ۳۲ حرف کوچک، رقم، زیرخط (_) و خط تیره (-) استفاده کنید که با یک حرف یا زیرخط شروع شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä enintään 32:ta pientä kirjainta, numeroa, alaviivaa (_) ja yhdysmerkkiä (-). Ensimmäisen merkin on oltava kirjain tai alaviiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez jusqu’à 32 lettres minuscules, chiffres, traits de soulignement (_) et traits d’union (-), en commençant par une lettre ou un trait de soulignement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez jusqu’à 32 lettres minuscules, chiffres, traits de soulignement (_) et traits d’union (-), en commençant par une lettre ou un trait de soulignement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વધુમાં વધુ 32 નાના અક્ષરો, અંકો, અંડરસ્કોર (_) અને હાઇફન (-)નો ઉપયોગ કરો, જેની શરૂઆત અક્ષર કે અંડરસ્કોરથી થતી હોય."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להשתמש בעד 32 אותיות לטיניות קטנות, ספרות, קווים תחתונים (_) ומקפים (-), כשהתו הראשון הוא אות או קו תחתון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम 32 छोटे अक्षरों, अंकों, अंडरस्कोर (_) और हाइफ़न (-) का उपयोग करें, और शुरुआत किसी अक्षर या अंडरस्कोर से करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotrijebite najviše 32 mala slova, znamenke, podvlake (_) i crtice (-), pri čemu prvi znak mora biti slovo ili podvlaka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb 32 kisbetűt, számjegyet, aláhúzásjelet (_) és kötőjelet (-) használjon. Az első karakter betű vagy aláhúzásjel legyen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan hingga 32 huruf kecil, angka, garis bawah (_), dan tanda hubung (-), diawali dengan huruf atau garis bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa fino a 32 lettere minuscole, cifre, trattini bassi (_) e trattini (-), iniziando con una lettera o un trattino basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英小文字、数字、アンダースコア（_）、ハイフン（-）を最大32文字まで使用でき、先頭は英字またはアンダースコアにする必要があります。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ең көбі 32 кіші әріпті, цифрды, астын сызуды (_) және дефисті (-) пайдаланыңыз. Атау әріптен немесе астын сызудан басталуы керек."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗರಿಷ್ಠ 32 ಸಣ್ಣ ಅಕ್ಷರಗಳು, ಅಂಕೆಗಳು, ಅಂಡರ್‌ಸ್ಕೋರ್‌ಗಳು (_) ಮತ್ತು ಹೈಫನ್‌ಗಳನ್ನು (-) ಬಳಸಿ. ಹೆಸರು ಅಕ್ಷರ ಅಥವಾ ಅಂಡರ್‌ಸ್ಕೋರ್‌ನಿಂದ ಪ್ರಾರಂಭವಾಗಬೇಕು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소문자, 숫자, 밑줄(_), 하이픈(-)을 최대 32자까지 사용할 수 있으며, 첫 글자는 문자나 밑줄이어야 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naudokite iki 32 mažųjų raidžių, skaitmenų, apatinių brūkšnių (_) ir brūkšnelių (-). Pirmas simbolis turi būti raidė arba apatinis brūkšnys."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരമാവധി 32 ചെറിയക്ഷരങ്ങൾ, അക്കങ്ങൾ, അണ്ടർസ്‌കോറുകൾ (_), ഹൈഫനുകൾ (-) എന്നിവ ഉപയോഗിക്കൂ. ആദ്യ പ്രതീകം അക്ഷരമോ അണ്ടർസ്‌കോറോ ആയിരിക്കണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जास्तीत जास्त 32 लहान अक्षरे, अंक, अंडरस्कोअर (_) आणि हायफन (-) वापरा. सुरुवात अक्षराने किंवा अंडरस्कोअरने करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan sehingga 32 huruf kecil, digit, garis bawah (_) dan tanda sempang (-), bermula dengan huruf atau garis bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk opptil 32 små bokstaver, sifre, understreker (_) og bindestreker (-), og start med en bokstav eller understrek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik maximaal 32 kleine letters, cijfers, underscores (_) en koppeltekens (-), te beginnen met een letter of underscore."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସର୍ବାଧିକ 32ଟି ଛୋଟ ଅକ୍ଷର, ଅଙ୍କ, ଅଣ୍ଡରସ୍କୋର୍ (_) ଓ ହାଇଫେନ୍ (-) ବ୍ୟବହାର କରନ୍ତୁ। ନାମ ଏକ ଅକ୍ଷର କିମ୍ବା ଅଣ୍ଡରସ୍କୋର୍‌ରେ ଆରମ୍ଭ ହେବା ଆବଶ୍ୟକ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੱਧ ਤੋਂ ਵੱਧ 32 ਛੋਟੇ ਅੱਖਰ, ਅੰਕ, ਅੰਡਰਸਕੋਰ (_) ਅਤੇ ਹਾਈਫ਼ਨ (-) ਵਰਤੋ। ਸ਼ੁਰੂਆਤ ਕਿਸੇ ਅੱਖਰ ਜਾਂ ਅੰਡਰਸਕੋਰ ਨਾਲ ਹੋਣੀ ਚਾਹੀਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj maksymalnie 32 małych liter, cyfr, podkreśleń (_) i łączników (-), zaczynając od litery lub podkreślenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use até 32 letras minúsculas, dígitos, sublinhados (_) e hifens (-), começando com uma letra ou sublinhado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use até 32 letras minúsculas, algarismos, traços de sublinhado (_) e hífenes (-), começando por uma letra ou traço de sublinhado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizați maximum 32 de litere mici, cifre, caractere de subliniere (_) și cratime (-), începând cu o literă sau un caracter de subliniere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте до 32 строчных латинских букв, цифр, символов подчеркивания (_) и дефисов (-). Имя должно начинаться с буквы или символа подчеркивания."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite najviac 32 malých písmen, číslic, podčiarkovníkov (_) a spojovníkov (-). Meno musí začínať písmenom alebo podčiarkovníkom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite največ 32 malih črk, števk, podčrtajev (_) in vezajev (-), pri čemer mora biti prvi znak črka ali podčrtaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd högst 32 gemener, siffror, understreck (_) och bindestreck (-). Namnet måste börja med en bokstav eller ett understreck."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிகபட்சம் 32 சிறிய எழுத்துகள், எண்கள், அடிக்கோடுகள் (_), இணைப்புக்குறிகள் (-) ஆகியவற்றைப் பயன்படுத்தவும். பெயர் எழுத்து அல்லது அடிக்கோட்டில் தொடங்க வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గరిష్ఠంగా 32 చిన్న అక్షరాలు, అంకెలు, అండర్‌స్కోర్‌లు (_), హైఫన్‌లు (-) ఉపయోగించండి. పేరు అక్షరంతో లేదా అండర్‌స్కోర్‌తో ప్రారంభం కావాలి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ตัวพิมพ์เล็ก ตัวเลข ขีดล่าง (_) และยัติภังค์ (-) ได้สูงสุด 32 ตัว โดยต้องขึ้นต้นด้วยตัวอักษรหรือขีดล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir harf veya alt çizgiyle başlayan, en fazla 32 küçük harf, rakam, alt çizgi (_) ve kısa çizgi (-) kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте до 32 малих латинських літер, цифр, підкреслень (_) і дефісів (-). Імʼя має починатися з літери або підкреслення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ سے زیادہ 32 چھوٹے حروف، ہندسے، انڈر اسکور (_) اور ہائفن (-) استعمال کریں، جس کا آغاز کسی حرف یا انڈر اسکور سے ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dùng tối đa 32 chữ thường, chữ số, dấu gạch dưới (_) và dấu gạch nối (-), bắt đầu bằng một chữ cái hoặc dấu gạch dưới."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可使用 32 個小寫字母、數字、底線（_）和連字號（-），並以字母或底線開頭。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多使用 32 个小写字母、数字、下划线 (_) 和连字符 (-)，并以字母或下划线开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可使用32個小寫字母、數字、底線（_）和連字號（-），且開頭須為字母或底線。"
          }
        }
      }
    },
