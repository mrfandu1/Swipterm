    "To use root, turn on Don’t Use Separate User.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای استفاده از root، گزینه «عدم استفاده از کاربر جداگانه» را روشن کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы использовать root, включите «Не использовать отдельного пользователя»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若要使用 root，请打开“不使用独立用户”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要使用 root，請開啟「不使用獨立使用者」。"
          }
        }
      }
    },
    "Unavailable": {
      "localizations": {
