    "All files and installed packages inside the container will be erased and you will return to setup.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه فایل‌ها و بسته‌های نصب‌شده داخل کانتینر پاک خواهند شد و به صفحه راه‌اندازی بازمی‌گردید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все файлы и установленные пакеты внутри контейнера будут удалены, и вы вернётесь к настройке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器内的所有文件和已安装的软件包都将被清除，并返回初始化界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "容器內的所有檔案與已安裝的套件都將被清除，並返回初始化畫面。"
          }
        }
      }
    },
